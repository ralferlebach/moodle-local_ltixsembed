{{!
    @template local_ltixsembed/audit

    Read-only embedding configuration audit.

    Example context (json):
    {
        "findings": [
            {"id": "origins_none", "level": "warning", "levellabel": "Warning", "iswarning": true, "text": "Example finding."}
        ],
        "facts": [
            {"name": "allowframembedding", "value": "yes"}
        ]
    }
}}
<div data-region="local_ltixsembed-audit">
    <p>{{#str}} audit_intro, local_ltixsembed {{/str}}</p>
    <p class="small">{{#str}} audit_fetchnote, local_ltixsembed {{/str}}</p>
    <h3 class="h5">{{#str}} audit_findings, local_ltixsembed {{/str}}</h3>
    <ul class="list-unstyled" data-region="findings">
        {{#findings}}
        <li class="mb-2" data-level="{{level}}" data-finding="{{id}}">
            <span class="badge {{#isok}}bg-success text-white{{/isok}}{{#isinfo}}bg-light text-dark border{{/isinfo}}{{#iswarning}}bg-warning text-dark{{/iswarning}}{{#iserror}}bg-danger text-white{{/iserror}}">{{levellabel}}</span>
            {{text}}
        </li>
        {{/findings}}
    </ul>
    <h3 class="h5">{{#str}} audit_facts, local_ltixsembed {{/str}}</h3>
    <table class="table table-sm generaltable">
        <tbody>
            {{#facts}}
            <tr><th scope="row">{{name}}</th><td>{{value}}</td></tr>
            {{/facts}}
        </tbody>
    </table>
</div>
