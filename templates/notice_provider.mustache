{{!
    @template local_ltixsembed/notice_provider

    Notice shown inside the embedded tool when it detects that it cannot keep a session in the frame.
    It stays hidden when the tool is shown in a top-level window or works normally.

    Runtime state is kept in data attributes of the region: data-lxs-current (detected state) and data-lxs-channel
    (none or open: whether the embedding platform answered the bridge handshake). With an open channel the platform owns
    the new-window option; without one (provider-only operation) the hint explains how to reopen the activity.

    Example context (json):
    {"storageaccess": true}
}}
<div class="local-ltixsembed-notice m-3" data-region="local_ltixsembed-notice" data-role="provider"
    data-lxs-current="pending" data-lxs-channel="none">
    <div class="alert alert-warning d-none" role="alert" data-region="state-message">
        <p class="mb-2 d-none" data-lxs-state="storage_unavailable">{{#str}} state_storage_unavailable_msg, local_ltixsembed {{/str}}</p>
        <p class="mb-2 d-none" data-lxs-state="session_lost">{{#str}} state_session_lost_msg, local_ltixsembed {{/str}}</p>
        <p class="mb-2 d-none" data-lxs-state="blocked_frame">{{#str}} state_blocked_frame_msg, local_ltixsembed {{/str}}</p>
        <p class="mb-2 d-none" data-lxs-state="needs_user_intervention">{{#str}} state_needs_user_intervention_msg, local_ltixsembed {{/str}}</p>
        {{#storageaccess}}
        <div class="mb-2 d-none" data-lxs-only="needs_user_intervention">
            <button type="button" class="btn btn-primary" data-action="request-storage-access">{{#str}} storageaccess_button, local_ltixsembed {{/str}}</button>
            <p class="small mt-2 mb-0">{{#str}} storageaccess_help, local_ltixsembed {{/str}}</p>
            <p class="mt-2 mb-0 d-none" role="status" data-region="storage-access-outcome">
                <span class="d-none" data-lxs-result="granted">{{#str}} storageaccess_granted, local_ltixsembed {{/str}}</span>
                <span class="d-none" data-lxs-result="granted_standalone">{{#str}} storageaccess_granted_standalone, local_ltixsembed {{/str}}</span>
                <span class="d-none" data-lxs-result="denied">{{#str}} storageaccess_denied, local_ltixsembed {{/str}}</span>
            </p>
        </div>
        {{/storageaccess}}
        <p class="mb-2" data-lxs-hint="standalone">{{#str}} provider_hint, local_ltixsembed {{/str}}</p>
        <p class="mb-2 d-none" data-lxs-hint="coop">{{#str}} provider_hint_coop, local_ltixsembed {{/str}}</p>
        <p class="small mb-0">{{#str}} privacynote, local_ltixsembed {{/str}}</p>
    </div>
</div>
